# ============================================================
# AdsCommand — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in your real values
# NEVER commit .env.local to version control!
#
# ⚠ ĐỌC TRƯỚC (đổi 17/09/2026 — repo chuyển sang trạng thái CÔNG KHAI):
# Các giá trị trước đây ghi cứng trong mã nay BẮT BUỘC đặt qua biến môi trường.
# Mã KHÔNG còn giá trị dự phòng: thiếu biến thì tính năng liên quan hiện "chưa
# cấu hình" hoặc báo lỗi rõ ràng, chứ KHÔNG âm thầm dùng số/host cũ. Cố ý như
# vậy — để giá trị thật làm fallback thì nó vẫn nằm trong repo công khai.
# Xem khối "⚠ BẮT BUỘC SAU KHI CHUYỂN SANG REPO CÔNG KHAI" ở cuối tệp.

# ---- Meta (Facebook) Ads ----
META_ACCESS_TOKEN=your_meta_access_token_here
META_AD_ACCOUNT_ID=your_ad_account_id_here
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
FB_PIXEL_ID_MBC=your_pixel_id_mbc
FB_PIXEL_ID_MBI=your_pixel_id_mbi

# ---- Google Ads API ----
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token
GOOGLE_ADS_CUSTOMER_ID_MBC=your_mbc_customer_id
GOOGLE_ADS_CUSTOMER_ID_MBI=your_mbi_customer_id
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your_mcc_login_customer_id

# ---- Telegram Alerts ----
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ---- Telegram — Báo cáo KPI cuối ngày (bot riêng: baocaokpimkt_bot) ----
# Cron /api/cron/kpi-report gửi báo cáo KPI MBC+MBI cuối mỗi ngày.
TELEGRAM_KPI_BOT_TOKEN=your_kpi_report_bot_token
# Chat nhận báo cáo KPI; bỏ trống = dùng TELEGRAM_CHAT_ID.
TELEGRAM_KPI_CHAT_ID=your_kpi_report_chat_id
# (tùy chọn) Đổi giờ gửi — cron UTC. Mặc định "0 14 * * *" = 21:00 giờ VN.
# KPI_REPORT_CRON=0 14 * * *

# ---- Telegram — Bản tin sức khỏe tài khoản buổi sáng ----
# Cron /api/alerts/digest gửi tổng hợp CPA vượt ngưỡng, ngân sách sắp hết,
# campaign bị từ chối, creative bão hòa, Quality Score giảm — MBC+MBI.
# Chat nhận bản tin; bỏ trống = dùng TELEGRAM_CHAT_ID.
# TELEGRAM_DIGEST_CHAT_ID=your_digest_chat_id
# (tùy chọn) Đổi giờ gửi — cron UTC. Mặc định "0 1 * * *" = 08:00 giờ VN.
# ALERTS_DIGEST_CRON=0 1 * * *

# ---- Google Gemini AI ----
GEMINI_API_KEY=your_gemini_api_key
# (tùy chọn) Tắt AI insight trên /google-audit — mặc định bật nếu có GEMINI_API_KEY.
# GOOGLE_AUDIT_AI_ENABLED=false

# ---- Google Analytics 4 ----
GA4_PROPERTY_ID=your_ga4_property_id
GA4_MEASUREMENT_ID=your_ga4_measurement_id
GA4_ACCESS_TOKEN=your_ga4_access_token
GA4_REFRESH_TOKEN=your_ga4_refresh_token

# ---- Auth (JWT) ----
JWT_SECRET=a_very_long_random_secret_string_at_least_32_chars
NEXTAUTH_SECRET=another_random_secret_for_nextauth
NEXTAUTH_URL=http://localhost:3000

# ---- Data encryption at rest ----
# AES-256-GCM key for encrypting credential fields stored in
# data/meta-settings.json and data/google-settings.json (access tokens,
# refresh tokens, app/client secrets). REQUIRED — the app refuses to boot
# without it (instrumentation.ts fails fast rather than silently falling
# back to plaintext). Generate with: openssl rand -base64 32
# After setting this for the first time on an existing deployment with
# plaintext settings files, run the one-time migration:
#   npx tsx -r dotenv/config scripts/migrate-encrypt-settings.ts dotenv_config_path=.env.local
DATA_ENCRYPTION_KEY=run_openssl_rand_-base64_32_to_generate_this

# ---- Rate limiting (optional) ----
# lib/rate-limit.ts is durable (file-backed, data/rate-limit.json) by
# default — fine for this app's current single-container deployment.
# REDIS_URL is NOT yet implemented (no Redis dependency in this project
# yet) — reserved for when/if this app ever runs as multiple instances,
# at which point the file-backed store stops being sufficient. Leave unset.
# REDIS_URL=redis://localhost:6379

# ---- Cron Jobs ----
CRON_SECRET=a_random_secret_for_cron_authorization

# ---- Email ----
RESEND_API_KEY=your_resend_api_key
REPORT_EMAILS=your@email.com

# ---- Integrations ----
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx
APIFY_API_TOKEN=your_apify_api_token
SERP_API_KEY=your_serp_api_key
SEARCH_API_KEY=your_search_api_key

# ---- App ----
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Next Best Action (NBA) ----
# off | dry_run | on  (mặc định dry_run — KHÔNG thực thi lên tài khoản quảng cáo)
NBA_AUTO_APPLY=dry_run
# Trần số action tự áp mỗi công ty mỗi lần chạy cron
NBA_AUTO_APPLY_MAX=3

# Bản tin buổi sáng trên Dashboard. MẶC ĐỊNH BẬT (bốn lỗi báo động giả đã sửa
# 26/08/2026 — xem lib/morning-briefing.ts). Đặt = 0 để tắt lại; khi tắt, route
# trả về ngay và không gọi Meta/Gemini lần nào.
ENABLE_MORNING_BRIEFING=1

# ============================================================
# ⚠ BẮT BUỘC SAU KHI CHUYỂN SANG REPO CÔNG KHAI (17/09/2026)
# ============================================================
# Không đặt các biến dưới đây thì tính năng tương ứng KHÔNG chạy.
# Mỗi khối ghi rõ hỏng như thế nào khi thiếu, để không ai phải đoán.

# ---- Tài khoản quản trị đầu tiên (lib/team.ts) ----
# Chỉ dùng khi data/team-members.json chưa có (lần chạy đầu / volume rỗng).
# Bản cũ tự tạo super_admin với một mật khẩu GHI CỨNG trong mã — lỗ hổng
# nghiêm trọng khi repo công khai, và nó chạy lại mỗi lần triển khai lên nền
# tảng không có volume bền. Nay PHẢI cấp qua biến, mật khẩu tối thiểu 12 ký tự.
# Thiếu → KHÔNG tạo tài khoản nào, log lỗi to (thà không đăng nhập được còn hơn
# mở sẵn cửa super_admin với mật khẩu ai cũng đọc được trên GitHub).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=   # tuỳ chọn, mặc định lấy phần trước @ của email

# ---- Odoo / ERP (lib/odoo-config.ts) ----
# Thiếu → mọi tính năng doanh thu Odoo báo "Odoo chưa cấu hình"; cron
# orders-notify vẫn gửi thẻ nhưng không có link mở đơn.
ODOO_URL=
ODOO_DB=
# ODOO_LOGIN / ODOO_API_KEY / ODOO_PASSWORD: xem khối Odoo ở trên (nếu có).

# ---- Mắt Bão Report API (doanh thu tháng, P&L) ----
# ⚠ Đây là API nội bộ KHÔNG YÊU CẦU XÁC THỰC mà trả về doanh thu thật. Vì vậy
# host của nó tuyệt đối không được nằm trong repo công khai.
# Thiếu → /api/odoo/revenue-monthly và P&L trả lỗi rõ ("MATBAO_REPORT_API chưa
# cấu hình"), biểu đồ doanh thu Dashboard trống.
MATBAO_REPORT_API=

# ---- Đăng nhập dự phòng qua hệ thống SEO (app/api/auth/login) ----
# Nhánh này GỬI email + mật khẩu người dùng sang hệ thống khác.
# Thiếu → bỏ hẳn nhánh dự phòng, chỉ còn đăng nhập bằng team-members.json.
SEO_API_URL=

# ---- Meta Page / Pixel + GA4 theo công ty (lib/meta-accounts.ts) ----
# Dùng tiền tố NEXT_PUBLIC_ vì các trang cần chúng là client component (pixel
# phải chạy ở trình duyệt). Giá trị vẫn đi vào gói client — ĐÚNG NHƯ TRƯỚC —
# điều thay đổi là chúng không còn nằm trong repo.
# Thiếu → trang Creative hiện "chưa cấu hình", không khởi chạy campaign được.
NEXT_PUBLIC_META_PAGE_ID_MBC=
NEXT_PUBLIC_META_PAGE_ID_MBI=
NEXT_PUBLIC_META_PIXEL_ID_MBC=
NEXT_PUBLIC_META_PIXEL_ID_MBI=
NEXT_PUBLIC_META_PIXEL_ID_SALE_AI=
# Nhãn hiển thị (tuỳ chọn, mặc định là mã công ty) — để tên fanpage/site cũng
# không nằm trong mã:
# NEXT_PUBLIC_META_PAGE_LABEL_MBC=
# NEXT_PUBLIC_META_PAGE_LABEL_MBI=
# NEXT_PUBLIC_META_PIXEL_LABEL_MBC=
# NEXT_PUBLIC_META_PIXEL_LABEL_MBI=

# GA4 theo công ty. Property ID nhận cả "123456789" và "properties/123456789".
# Thiếu → cột GA4 ở trang Tracking / Campaigns trống.
NEXT_PUBLIC_GA4_PROPERTY_ID_MBC=
NEXT_PUBLIC_GA4_STREAM_ID_MBC=
NEXT_PUBLIC_GA4_MEASUREMENT_ID_MBC=
NEXT_PUBLIC_GA4_PROPERTY_ID_MBI=
NEXT_PUBLIC_GA4_STREAM_ID_MBI=
NEXT_PUBLIC_GA4_MEASUREMENT_ID_MBI=
NEXT_PUBLIC_GA4_PROPERTY_ID_SALE_AI=
NEXT_PUBLIC_GA4_STREAM_ID_SALE_AI=
NEXT_PUBLIC_GA4_MEASUREMENT_ID_SALE_AI=

# ---- Ngưỡng CPL theo SẢN PHẨM (lib/cpl-targets.ts) ----
# Đơn vị VND. Khoá là nhóm sản phẩm (không phân biệt hoa/thường); DEFAULT dùng
# cho nhóm không khai báo. Thiếu → mọi ngưỡng = 0, phần so ngưỡng vô nghĩa
# (gợi ý từ khoá / bid sẽ không có mốc CPA để so).
CPL_TARGETS_JSON={"HOSTING":800000,"DOMAIN":500000,"SSL":1000000,"EINVOICE":2000000,"ESIGN":1500000,"SALEAI":300000,"DEFAULT":1000000}

# ---- Ngưỡng CPL theo CÔNG TY (lib/business-profile/defaults.ts) ----
# Khoá là tenantId (mbc / mbi / sale_ai). Phải theo thứ tự good < warning <
# critical, nếu không cả bộ bị bỏ (ngưỡng sai thứ tự làm báo động luôn đỏ hoặc
# luôn xanh). Nhãn hiển thị được SINH từ chính ba con số nên không lệch được.
# Thiếu → cplThresholds = null, giao diện không hiện phần phân loại CPL.
CPL_THRESHOLDS_JSON={"mbc":{"good":60000,"warning":99000,"critical":100000},"mbi":{"good":150000,"warning":250000,"critical":251000}}

# ---- Danh mục sản phẩm quảng cáo (lib/ad-product-mapping.ts) ----
# Mảng JSON, THỨ TỰ QUAN TRỌNG (first-match-wins, so khớp bằng `includes`):
# đặt rule cụ thể TRƯỚC rule chung, vd "PAGE SALE AI" trước "SALE AI",
# "CHUNG CHI VMC" trước "SSL", "VIBE" trước "WORDPRESS HOSTING".
# `revenueKey` CHỈ đặt khi đã xác minh trên ERP đúng là nhóm doanh thu của sản
# phẩm đó; gán bừa làm lệch bảng "Hiệu suất theo sản phẩm" cả hai chiều. Chưa
# chắc thì để null (vẫn theo dõi được chi phí).
# `match` viết có dấu cũng được — hệ thống tự bỏ dấu + in hoa khi nạp.
# Thiếu → khu vực "Chi phí Quảng Cáo Từng Sản Phẩm" KHÔNG có dòng nào.
# Giá trị thật xem trong ghi chú triển khai (không để trong repo công khai).
AD_PRODUCTS_JSON=[]

# ---- Email báo cáo tuần (app/api/reports/weekly/send) ----
# Địa chỉ gửi, phải thuộc domain đã xác thực ở Resend.
# Thiếu → Resend từ chối, log lỗi ngay (không gửi ẩn danh).
REPORT_EMAIL_FROM=

# ---- docker-compose (chỉ khi tự chạy compose, không dùng Coolify) ----
# Domain Traefik sẽ route. docker-compose.yml dùng ${APP_HOST:?...} nên thiếu
# biến là `docker compose up` dừng ngay với thông báo rõ.
# APP_HOST=ads-manager.example.com
